{
  "name": "@nikolay-grudanov/vacuum-opencode-lsp",
  "version": "0.6.0",
  "description": "LSP wrapper over vacuum CLI for OpenCode (and any LSP client). Provides real-time OpenAPI/AsyncAPI linting diagnostics with custom ruleset support and Node.js plugin script loading for cross-artifact validation.",
  "main": "index.js",
  "bin": {
    "vacuum-opencode-lsp": "index.js"
  },
  "scripts": {
    "start": "node index.js --stdio",
    "test": "node test/test-ruleset-flag.js && node test/test-rule-scripts.js && node test/test-binary-resolution.js",
    "prepublishOnly": "node scripts/fetch-vacuum-binary.js && npm test"
  },
  "keywords": [
    "lsp",
    "language-server",
    "openapi",
    "asyncapi",
    "vacuum",
    "linting",
    "opencode",
    "spectral",
    "rule-scripts",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "tar": "^7.4.0"
  },
  "peerDependencies": {
    "@quobix/vacuum": ">=0.29.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolay-grudanov/vacuum-opencode-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/nikolay-grudanov/vacuum-opencode-lsp/issues"
  },
  "homepage": "https://github.com/nikolay-grudanov/vacuum-opencode-lsp#readme",
  "author": {
    "name": "Nikolay Grudanov",
    "email": "grudanov.n.a@gmail.com",
    "url": "https://github.com/nikolay-grudanov"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "LICENSE",
    "examples/",
    "bin/",
    "scripts/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "@quobix/vacuum": {
      "optional": true
    }
  }
}